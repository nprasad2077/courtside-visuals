{
  "name": "courtside-visuals",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c auto \"tsx watch --env-file=.env server/index.ts\" \"vite\"",
    "dev:api": "tsx watch --env-file=.env server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx --env-file=.env server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.6-r.2",
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.6",
    "@floating-ui/react": "^0.27.20",
    "@tanstack/react-query": "^5.104.5",
    "d3-array": "^3.2.4",
    "d3-hexbin": "^0.2.2",
    "d3-interpolate": "^3.0.1",
    "d3-interpolate-path": "^2.3.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "downshift": "^9.4.0",
    "fastify": "^5.12.7",
    "lucide-react": "^1.60.0",
    "motion": "^14.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-hexbin": "^0.2.5",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
